# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/protocol

# Local development: allows the placeholder SECRET_KEY below. Production
# (the default) refuses to start with an empty or placeholder SECRET_KEY.
APP_ENV=dev

# Auth
# First user's password, only used while the database has no users.
APP_PASSWORD=your-secure-password
SECRET_KEY=your-secret-key-change-this-in-production

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000"]

# Claude API (for food photo estimation)
ANTHROPIC_API_KEY=
